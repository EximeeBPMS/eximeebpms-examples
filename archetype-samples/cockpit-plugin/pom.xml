<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example.eximeebpms.bpm</groupId>
  <artifactId>eximeebpms-cockpit-plugin</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <packaging>jar</packaging>

  <name>EximeeBPMS Cockpit Plugin: EximeeBPMS Cockpit Plugin</name>
  <description>A simple plugin that showcases the plugin system of Cockpit, the process monitoring tool of [EximeeBPMS](https://docs.eximeebpms.org). [The project has been generated by the Maven archetype 'eximeebpms-archetype-cockpit-plugin-1.3.0']</description>
  <url></url>

  <properties>
    <eximeebpms.version>1.3.0</eximeebpms.version>

    <!-- This property must be present for the pom.xml to be recognized as a plugin -->
    <eximeebpms.plugin.category>Please select one of Sample|Monitoring|Exploration|Business</eximeebpms.plugin.category>

    <eximeebpms.plugin.screenshot>screenshot.png</eximeebpms.plugin.screenshot>
    <!-- <eximeebpms.plugin.screenshot.1>screenshot2.png</eximeebpms.plugin.screenshot.1> -->
    <eximeebpms.plugin.testedOnVersion>1.3.0</eximeebpms.plugin.testedOnVersion>
    <!-- <eximeebpms.plugin.exampleProcessApplicationUrl></eximeebpms.plugin.exampleProcessApplicationUrl> -->
    <eximeebpms.plugin.language>EN</eximeebpms.plugin.language>

    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.eximeebpms.bpm</groupId>
        <artifactId>eximeebpms-bom</artifactId>
        <version>${eximeebpms.version}</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- process engine, needs to be provided -->
      <groupId>org.eximeebpms.bpm</groupId>
      <artifactId>eximeebpms-engine</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <!-- Cockpit Plugin API, needs to be provided -->
      <groupId>org.eximeebpms.bpm.webapp</groupId>
      <artifactId>eximeebpms-webapp</artifactId>
      <classifier>classes</classifier>
      <!-- not part of eximeebpms bom -->
      <version>${eximeebpms.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Jakarta EE APIs -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-api</artifactId>
      <version>10.0.0</version>
      <scope>provided</scope>
    </dependency>

  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
