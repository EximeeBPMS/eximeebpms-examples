template header
name
amountMin
amountMax
discount

package org.eximeebpms.bpm.demo.orderconfirmation
import org.eximeebpms.bpm.demo.orderconfirmation.model.*;

template "discount rule"
rule "@{name}"
when
   o: Order( amount > @{amountMin},  amount <= @{amountMax})
then
   o.setDiscount( @{discount});
   o.setDiscountReason( drools.getRule().getName() );
end

end template