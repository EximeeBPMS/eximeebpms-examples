<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>\${groupId}</groupId>
  <artifactId>\${artifactId}</artifactId>
  <version>\${version}</version>

  <packaging>jar</packaging>

  <name>EximeeBPMS Cockpit Plugin: ${eximeebpms-plugin-name}</name>
  <description>${eximeebpms-plugin-description} [The project has been generated by the Maven archetype 'eximeebpms-archetype-cockpit-plugin-${project.version}']</description>
  <url></url>

  <properties>
    <eximeebpms.version>${eximeebpms-version}</eximeebpms.version>

    <!-- This property must be present for the pom.xml to be recognized as a plugin -->
    <eximeebpms.plugin.category>${eximeebpms-plugin-category}</eximeebpms.plugin.category>

    <eximeebpms.plugin.screenshot>${eximeebpms-plugin-screenshot}</eximeebpms.plugin.screenshot>
    <!-- <eximeebpms.plugin.screenshot.1>screenshot2.png</eximeebpms.plugin.screenshot.1> -->
    <eximeebpms.plugin.testedOnVersion>${eximeebpms-plugin-testedOnVersion}</eximeebpms.plugin.testedOnVersion>
    <!-- <eximeebpms.plugin.exampleProcessApplicationUrl></eximeebpms.plugin.exampleProcessApplicationUrl> -->
    <eximeebpms.plugin.language>${eximeebpms-plugin-language}</eximeebpms.plugin.language>

    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.eximeebpms.bpm</groupId>
        <artifactId>eximeebpms-bom</artifactId>
        <version>${eximeebpms.version}</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- process engine, needs to be provided -->
      <groupId>org.eximeebpms.bpm</groupId>
      <artifactId>eximeebpms-engine</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <!-- Cockpit Plugin API, needs to be provided -->
      <groupId>org.eximeebpms.bpm.webapp</groupId>
      <artifactId>eximeebpms-webapp</artifactId>
      <classifier>classes</classifier>
      <!-- not part of eximeebpms bom -->
      <version>${eximeebpms.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Jakarta EE APIs -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-api</artifactId>
      <version>10.0.0</version>
      <scope>provided</scope>
    </dependency>

  </dependencies>

  <build>
    <finalName>\${project.artifactId}</finalName>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${version.maven-compiler-plugin}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
